/**
 * Приймач статистики тесту «Перевірте, чи легко вами маніпулювати».
 *
 * Аркуш "results" — один рядок на проходження:
 *   Дата | Бали | Рівень | Q1 | Q2 | … | Q10
 *   (у клітинці питання: обрана літера + ✓/✗, наприклад "Б ✓")
 * Аркуш "questions" — довідник: Q# | Пастка | Текст питання.
 *   Заповнюється один раз функцією setupQuestions (Run у редакторі).
 *
 * Після зміни коду: Deploy → Manage deployments → ✏️ → Deploy.
 */
function doPost(e) {
  var data = JSON.parse(e.postData.contents);
  var ss = SpreadsheetApp.getActiveSpreadsheet();

  var res = ss.getSheetByName("results") || ss.insertSheet("results");
  if (res.getLastRow() === 0) {
    var head = ["Дата", "Бали", "Рівень"];
    for (var i = 1; i <= 10; i++) head.push("Q" + i);
    res.appendRow(head);
  }
  var byId = {};
  (data.answers || []).forEach(function (a) { byId[a.id] = a; });
  var row = [new Date(), data.score, data.level];
  for (var q = 1; q <= 10; q++) {
    var a = byId[q];
    row.push(a ? a.picked + " " + (a.ok ? "✓" : "✗") : "");
  }
  res.appendRow(row);

  return ContentService.createTextOutput("ok");
}

/** Разове заповнення довідника питань: Extensions → Apps Script → Run → setupQuestions */
function setupQuestions() {
  var QUESTIONS = [
    [1, "Упередження підтвердження", "Який матеріал ви відкриєте першим і прочитаєте з більшою увагою? (велодоріжки: два заголовки)"],
    [2, "Упередження підтвердження", "Якою буде ваша реакція після прочитання цього тексту? (колонка про податки для ФОПів)"],
    [3, "Ефект фреймінгу", "Який заголовок інтуїтивно викликає у вас більше бажання віднести гроші до банку? (депозити: зберегти 85% vs втратити 15%)"],
    [4, "Ефект фреймінгу", "Чому ці два видання, описуючи одну й ту саму подію, викликають протилежні емоції? (зведення ППО: 80% збито vs 20% прорвалось)"],
    [5, "Евристика доступності", "Чому поїздка автомобілем інтуїтивно здається вашим знайомим безпечнішою за переліт? (літаки vs автомобілі)"],
    [6, "Евристика доступності", "Чому після прочитання виникає інтуїтивне відчуття, що небезпека тепер у кожній шаурмічній? (вірусний допис про отруєння)"],
    [7, "Ефект ілюзорної правди", "Наскільки впевнено ви почуватиметеся, оплачуючи покупку на незнайомому сайті в режимі «Інкогніто»? (міф про режим інкогніто)"],
    [8, "Ефект ілюзорної правди", "Як ви відреагуєте на таке повідомлення? (фейк про блокування карток і 19,5% податку)"],
    [9, "Упередження авторитету", "Як ця категорична порада від всесвітньо відомого інноватора має вплинути на ставлення до медичних призначень? (Маск про антидепресанти)"],
    [10, "Упередження авторитету", "Який із цих двох прогнозів викликає у вас більше довіри для ухвалення фінансового рішення? (нерухомість: анонім vs чиновник)"],
  ];
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName("questions") || ss.insertSheet("questions");
  sh.clear();
  sh.appendRow(["Q#", "Пастка", "Текст питання"]);
  QUESTIONS.forEach(function (r) { sh.appendRow(r); });
}
